<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="posttestapd1bonuspromaxxx"/>
        <attribute name="authors" value="Maulyanda Yuan"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 10:18:42 PM"/>
        <attribute name="created" value="TWF1bHlhbmRhIFl1YW47QVNVUzsyMDI2LTA5LTE1OzA3OjM5OjM1IFBNOzI5ODE="/>
        <attribute name="edited" value="TWF1bHlhbmRhIFl1YW47QVNVUzsyMDI2LTA5LTE1OzA3OjM5OjM4IFBNOzE7TWF1bHlhbmRhIFl1YW47QVNVUzsyMDI2LTA5LTEyOzEwOjMwOjI5IFBNO3Bvc3R0ZXN0YXBkMWJvbnVzLmZwcmc7ODQ2NA=="/>
        <attribute name="edited" value="TWF1bHlhbmRhIFl1YW47QVNVUzsyMDI2LTA5LTE2OzEwOjE4OjQyIFBNOzg7MzA4Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="UsiaMentah" type="String" array="False" size=""/>
            <declare name="i, n, UsiaBenar, JumlahTiket, HargaTiket, HargaTotal, NomorFilm" type="Integer" array="False" size=""/>
            <declare name="adalahBenar, DiBawahUmur" type="Boolean" array="False" size=""/>
            <assign variable="adalahBenar" expression="False"/>
            <assign variable="DiBawahUmur" expression="False"/>
            <assign variable="HargaTotal" expression="0"/>
            <output expression="&quot;Selamat datang di CineMax!&quot; &amp; ToChar(13) &amp; &quot;Masukkan jumlah tiket: &quot;" newline="True"/>
            <input variable="JumlahTiket"/>
            <for variable="i" start="1" end="JumlahTiket" direction="inc" step="1">
                <while expression="adalahBenar == False">
                    <output expression="&quot;Masukkan usia orang ke-&quot; &amp; i" newline="True"/>
                    <input variable="UsiaMentah"/>
                    <assign variable="adalahBenar" expression="True"/>
                    <if expression="Len(UsiaMentah) == 0">
                        <then>
                            <assign variable="adalahBenar" expression="False"/>
                        </then>
                        <else>
                            <for variable="n" start="0" end="Len(UsiaMentah) - 1" direction="inc" step="1">
                                <if expression="ToString(Char(UsiaMentah, n)) &lt; &quot;0&quot; or ToString(Char(UsiaMentah, n)) &gt; &quot;9&quot;">
                                    <then>
                                        <assign variable="adalahBenar" expression="False"/>
                                    </then>
                                    <else/>
                                </if>
                            </for>
                        </else>
                    </if>
                    <if expression="adalahBenar == True">
                        <then>
                            <assign variable="UsiaBenar" expression="ToInteger(UsiaMentah)"/>
                            <if expression="UsiaBenar = 0">
                                <then>
                                    <output expression="&quot;Usia tidak boleh kurang dari atau sama dengan 0.&quot;" newline="True"/>
                                    <assign variable="adalahBenar" expression="False"/>
                                </then>
                                <else/>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;Usia tidak boleh kosong, mengandung angka atau simbol, dan kurang dari atau sama dengan 0.&quot;" newline="True"/>
                        </else>
                    </if>
                </while>
                <if expression="UsiaBenar &gt;= 17">
                    <then/>
                    <else>
                        <assign variable="DiBawahUmur" expression="True"/>
                        <output expression="&quot;Usia anda &quot; &amp; UsiaBenar &amp; &quot; tidak memenuhi kategori dewasa. Tontolah film sesuai usia.&quot;" newline="True"/>
                    </else>
                </if>
                <if expression="UsiaBenar &lt; 12">
                    <then>
                        <assign variable="HargaTiket" expression="60000-(60000*0.2)"/>
                    </then>
                    <else>
                        <if expression="UsiaBenar &gt; 60">
                            <then>
                                <assign variable="HargaTiket" expression="60000-(60000*0.3)"/>
                            </then>
                            <else>
                                <assign variable="HargaTiket" expression="60000"/>
                            </else>
                        </if>
                    </else>
                </if>
                <assign variable="HargaTotal" expression="HargaTotal+ HargaTiket"/>
                <assign variable="adalahBenar" expression="False"/>
            </for>
            <output expression="&quot;--- DAFTAR TAYANG ---&quot; &amp; ToChar(13) &amp; &quot;1. Si Kancil&quot; &amp; ToChar(13) &amp; &quot;2. Gintama the Movie: Yoshiwara in Flames (17+)&quot; &amp; ToChar(13) &amp; &quot;Pilih nomor film: &quot;" newline="True"/>
            <input variable="NomorFilm"/>
            <if expression="DiBawahUmur = True">
                <then>
                    <while expression="NomorFilm = 2">
                        <output expression="&quot;Anda atau rekan anda tidak memenuhi batas usia.&quot; &amp; ToChar(13) &amp; &quot;Silahkan pilih film lain: &quot;" newline="True"/>
                        <input variable="NomorFilm"/>
                    </while>
                    <output expression="&quot;Film: Si Kancil&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="NomorFilm = 2">
                        <then>
                            <output expression="&quot;Film: Gintama the Movie: Yoshiwara in Flames&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Film: Si Kancil&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Harga tiket total: Rp.&quot; &amp; HargaTotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
