<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="posttestapdp1"/>
        <attribute name="authors" value="Maulyanda Yuan"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-14 10:55:37 PM"/>
        <attribute name="created" value="TWF1bHlhbmRhIFl1YW47QVNVUzsyMDI2LTA5LTEyOzEwOjMwOjI5IFBNOzI5NjY="/>
        <attribute name="edited" value="TWF1bHlhbmRhIFl1YW47QVNVUzsyMDI2LTA5LTE0OzEwOjU1OjM3IFBNOzc7MzA4OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, Usia, JumlahTiket, HargaTiket, HargaTotal, NomorFilm, DiBawahUmur" type="Integer" array="False" size=""/>
            <assign variable="HargaTotal" expression="0"/>
            <assign variable="DiBawahUmur" expression="0"/>
            <output expression="&quot;Selamat datang di CineMax!&quot; &amp; ToChar(13) &amp; &quot;Masukkan jumlah tiket: &quot;" newline="True"/>
            <input variable="JumlahTiket"/>
            <for variable="i" start="1" end="JumlahTiket" direction="inc" step="1">
                <output expression="&quot;Masukkan usia orang ke-&quot; &amp; i" newline="True"/>
                <input variable="Usia"/>
                <while expression="Usia &lt;= 0">
                    <output expression="&quot;Masukkan usia yang valid.&quot; &amp; ToChar(13) &amp; &quot;Masukkan usia anda: &quot;" newline="True"/>
                    <input variable="Usia"/>
                </while>
                <if expression="Usia &gt;= 17">
                    <then/>
                    <else>
                        <assign variable="DiBawahUmur" expression="1"/>
                        <output expression="&quot;Usia anda &quot; &amp; Usia &amp; &quot; tidak memenuhi kategori dewasa. Tontolah film sesuai usia.&quot;" newline="True"/>
                    </else>
                </if>
                <if expression="Usia &lt; 12">
                    <then>
                        <assign variable="HargaTiket" expression="60000-(60000*0.2)"/>
                    </then>
                    <else>
                        <if expression="Usia &gt; 60">
                            <then>
                                <assign variable="HargaTiket" expression="60000-(60000*0.3)"/>
                            </then>
                            <else>
                                <assign variable="HargaTiket" expression="60000"/>
                            </else>
                        </if>
                    </else>
                </if>
                <assign variable="HargaTotal" expression="HargaTotal+ HargaTiket"/>
            </for>
            <output expression="&quot;Daftar tayang:&quot; &amp; ToChar(13) &amp; &quot;1. Si Kancil&quot; &amp; ToChar(13) &amp; &quot;2. Gintama the Movie: Yoshiwara in Flames (17+)&quot; &amp; ToChar(13) &amp; &quot;Pilih nomor film: &quot;" newline="True"/>
            <input variable="NomorFilm"/>
            <if expression="DiBawahUmur = 1">
                <then>
                    <while expression="NomorFilm = 2">
                        <output expression="&quot;Anda atau rekan anda tidak memenuhi batas usia.&quot; &amp; ToChar(13) &amp; &quot;Silahkan pilih film lain: &quot;" newline="True"/>
                        <input variable="NomorFilm"/>
                    </while>
                    <output expression="&quot;Film: Si Kancil&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="NomorFilm = 2">
                        <then>
                            <output expression="&quot;Film: Gintama the Movie: Yoshiwara in Flames&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Film: Si Kancil&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Harga tiket total: Rp.&quot; &amp; HargaTotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
